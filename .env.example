# Copy this file to .env. Never commit real secrets.
INITIAL_CAPITAL=1000
TRADING_ALLOCATION=900
PROTECTED_RESERVE=100
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
GROWW_ENABLED=false
APP_PASSWORD=change-this-to-a-long-unique-password
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local development default. For Streamlit Cloud, create a free Neon Postgres project
# and set DATABASE_URL in Streamlit Secrets (see docs/free-database-setup.md).
DATABASE_URL=sqlite:///data/alphafund.db

# AI provider: ollama (private local model) or openai (cloud)
ALPHAFUND_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Cloud fallback sends portfolio metrics to OpenAI; keep false for local-only privacy.
OPENAI_FALLBACK_ENABLED=false
