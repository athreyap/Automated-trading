# Copy this file to .env. Never commit real secrets.
INITIAL_CAPITAL=1000
TRADING_ALLOCATION=900
PROTECTED_RESERVE=100
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
GROWW_ENABLED=false
APP_PASSWORD=change-this-to-a-long-unique-password
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=

# Managed open-weight model via Hugging Face Inference Providers (recommended).
# Create a token with Inference Providers permissions at https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_MODEL=openai/gpt-oss-120b:cheapest
ALPHAFUND_AI_PROVIDER=huggingface
# Explicit consent required before portfolio records are sent to managed inference.
ALPHAFUND_CLOUD_DATA_SHARING=false

# Optional alternatives
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_FALLBACK_ENABLED=false

# Local development defaults to SQLite. Use Neon DATABASE_URL for cloud persistence.
DATABASE_URL=sqlite:///data/alphafund.db
